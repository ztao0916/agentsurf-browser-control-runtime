{
  "name": "@agentsurf/mcp-server",
  "version": "0.1.0",
  "description": "Local MCP server and Chrome browser control runtime for AI agents.",
  "keywords": ["mcp", "browser-automation", "chrome", "agentsurf"],
  "bin": {
    "agentsurf-mcp": "./dist/mcp/cli.js"
  },
  "files": ["dist/mcp", "dist/native-host"],
  "publishConfig": {
    "access": "public"
  },
  "prepublishOnly": "npm run build",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-icons.mjs && node scripts/build.mjs",
    "bridge": "node dist/bridge/server.js",
    "bridge:dev": "npm run build && node dist/bridge/server.js",
    "bridge:call": "node scripts/call-tool.mjs",
    "native-host:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-native-host.ps1",
    "native-host:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-native-host.ps1",
    "native-host:install:macos": "node scripts/install-native-host-macos.mjs",
    "native-host:uninstall:macos": "node scripts/uninstall-native-host-macos.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "typebox": "1.3.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
