{
  "name": "agentsurf-mcp",
  "version": "0.7.0",
  "description": "Local and remote MCP server giving AI agents safe control over your signed-in Chrome/Edge browser.",
  "mcpName": "io.github.ztao0916/agentsurf",
  "license": "Apache-2.0",
  "author": "ztao",
  "homepage": "https://github.com/ztao0916/agentsurf-browser-control-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztao0916/agentsurf-browser-control-runtime.git"
  },
  "bugs": "https://github.com/ztao0916/agentsurf-browser-control-runtime/issues",
  "keywords": ["mcp", "mcp-server", "browser-automation", "chrome", "edge", "agentsurf"],
  "bin": {
    "agentsurf-mcp": "dist/mcp/cli.js"
  },
  "files": ["dist/mcp", "dist/native-host"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prepublishOnly": "npm run build",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/generate-icons.mjs && node scripts/build.mjs",
    "setup": "node scripts/setup.mjs",
    "bridge": "node dist/bridge/server.js",
    "bridge:dev": "npm run build && node dist/bridge/server.js",
    "bridge:call": "node scripts/call-tool.mjs",
    "native-host:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-native-host.ps1",
    "native-host:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-native-host.ps1",
    "native-host:install:macos": "node scripts/install-native-host-macos.mjs",
    "native-host:uninstall:macos": "node scripts/uninstall-native-host-macos.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e:remote": "node scripts/remote-extension-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "typebox": "1.3.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
